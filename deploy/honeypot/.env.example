# Loopback-only ports published by the relay containers.
HONEYPOT_SSH_PORT=12222
HONEYPOT_WEB_PORT=18080

# This is a decoy password, not a secret boundary. Change it if you want a
# different lure, but never reuse a real account password here.
HONEYPOT_SSH_PASSWORD=highwall-decoy-only

# Per-container connection and transfer limits. The relay caps visible TCP
# sessions; the web decoy caps HTTP handlers and request lifetime separately.
HONEYPOT_RELAY_MAX_CONNECTIONS=64
HONEYPOT_RELAY_MAX_CONNECTIONS_PER_IP=16
HONEYPOT_RELAY_IDLE_TIMEOUT_SECONDS=300
HONEYPOT_RELAY_MAX_CONNECTION_SECONDS=3600
HONEYPOT_RELAY_MAX_BYTES_PER_DIRECTION=67108864
HONEYPOT_WEB_MAX_CONNECTIONS=32
HONEYPOT_WEB_IDLE_TIMEOUT_SECONDS=30
HONEYPOT_WEB_MAX_CONNECTION_SECONDS=120
