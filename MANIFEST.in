include LICENSE NOTICE README.md README.en.md SECURITY.md config.example.json Dockerfile .dockerignore
recursive-include docs *.md
recursive-include deploy *
recursive-include scripts *.ps1 *.py
recursive-include tests *.py
recursive-include subprojects *.py *.md *.json *.ps1
global-exclude __pycache__ *.py[cod] *.egg-info
prune build
prune dist
